{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://craftforge.local/contracts/export-job.schema.json",
  "title": "ExportJobMessage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "modpackId": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "string",
      "enum": ["CLIENT", "SERVER", "BOTH"]
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["jobId", "modpackId", "target", "requestedAt"]
}
